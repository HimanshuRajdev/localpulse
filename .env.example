# Copy this file to .env and fill in your keys. .env is gitignored.

# Free at https://myprojects.geoapify.com (no card). Fast place lookups.
GEOAPIFY_API_KEY=

# https://platform.openai.com/api-keys . Only needed for the ideas button.
OPENAI_API_KEY=

